<?xml version="1.0" encoding="UTF-8"?>
<ldlib2-ui>
    <stylesheet location="ldlib2:lss/gdp.lss" />
    <style>
        #lobby-root { width: 1280; height: 720; }
        #lobby-canvas { width: 100%; height: 100%; align-items: center; justify-content: center; background: rect(#E818171E); }
        #lobby-panel { width: 940; height: 584; padding-all: 22; gap-all: 20; background: built-in(ui-gdp:BORDER_THICK_RT1); }
        label, text { font-size: 16; text-color: #FFFFFF; text-shadow: true; }
        .row { flex-direction: row; gap-all: 12; align-items: center; }
        .grow { flex: 1; min-width: 0; min-height: 0; }
        .wrap { width: 100%; text-wrap: wrap; adaptive-height: true; }
        .heading { font-size: 22; }
        #lobby-canvas button { height: 40; min-width: 100; flex-shrink: 0; background: built-in(ui-gdp:RECT); }
        .keyboard-focus { background: rect(#FF665378); }
        .keyboard-focus text { text-color: #FFF0B8; }
        #lobby-help { min-width: 40; width: 40; }
        #lobby-body { flex: 1; min-height: 0; flex-direction: row; gap-all: 22; }
        #lobby-left { width: 260; gap-all: 16; }
        #lobby-deck-box { padding-all: 16; gap-all: 12; background: rect(#FF1B1923); }
        #lobby-right { flex: 1; min-width: 0; gap-all: 20; }
        #lobby-left > .__scroller_view_view-port__ > .__scroller_view_view-container__ { gap-all: 16; }
        #lobby-right > .__scroller_view_view-port__ > .__scroller_view_view-container__ { gap-all: 20; }
        #lobby-players { height: 278; width: 100%; }
        .player-row { width: 100%; height: 40; margin-bottom: 5; }
        #lobby-hands button { flex: 1; min-width: 0; height: 80; }
        #lobby-first-choice button { flex: 1; }
        #lobby-footer { height: 60; flex-direction: row; gap-all: 12; align-items: center; }
        #lobby-feedback, #settings-error { text-color: #EBBC82; }
        #management-help, #lobby-settings-dialog { position: absolute; left: 0; top: 0; width: 100%; height: 100%; align-items: center; justify-content: center; background: rect(#CC08070C); z-index: 90; }
        .dialog-panel { width: 480; padding-all: 22; gap-all: 16; background: built-in(ui-gdp:BORDER_THICK_RT1); }
        text-field, selector { height: 36; width: 100%; flex-shrink: 0; }
        .__selector_preview__ label, .__selector_dialog__ label { height: 28; flex-shrink: 0; }
        .__selector_dialog__ { z-index: 95; }
        #settings-seed { height: 36; }
    </style>
    <root id="lobby-root"><element id="lobby-canvas">
        <element id="lobby-panel">
            <element class="row"><button id="lobby-home" text="Home" /><label class="heading grow">Duel</label><button id="lobby-help" text="?" /><button id="lobby-close" text="Close" /></element>
            <element id="lobby-body">
                <scroller-view id="lobby-left">
                    <element id="lobby-deck-box"><label>Your active deck</label><text id="lobby-deck" class="wrap" /><button id="lobby-select-deck" text="Select deck" /></element>
                    <text id="lobby-options" class="wrap" />
                    <button id="lobby-settings" text="Settings" />
                </scroller-view>
                <scroller-view id="lobby-right">
                    <text id="lobby-prompt" class="heading wrap" />
                    <scroller-view id="lobby-players" />
                    <element id="lobby-hands" class="row"><button id="lobby-rock" text="Rock" /><button id="lobby-paper" text="Paper" /><button id="lobby-scissors" text="Scissors" /></element>
                    <element id="lobby-first-choice" class="row"><button id="lobby-first" text="Go first" /><button id="lobby-second" text="Go second" /></element>
                    <label id="lobby-countdown" />
                    <button id="lobby-retry" text="Retry" />
                </scroller-view>
            </element>
            <element id="lobby-footer"><text id="lobby-feedback" class="grow wrap" /><button id="lobby-invite" text="Invite" /><button id="lobby-accept" text="Accept" /><button id="lobby-decline" text="Decline" /><button id="lobby-cancel" text="Cancel" /></element>
        </element>
        <element id="lobby-settings-dialog"><element class="dialog-panel"><element class="row"><label class="heading grow">Duel settings</label><button id="settings-close" text="Close" /></element><label>Rule preset</label><selector id="settings-rule" /><label>Life points</label><text-field id="settings-lp" /><label>Starting hand</label><text-field id="settings-hand" /><label>Draw per turn</label><text-field id="settings-draw" /><label>Seed (optional)</label><text-field id="settings-seed" /><text id="settings-error" class="wrap" /></element></element>
        <element id="management-help"><element class="dialog-panel"><label class="heading">Duel help</label><text id="lobby-help-copy" class="wrap" /><button id="help-close" text="Close" /></element></element>
    </element></root>
</ldlib2-ui>
