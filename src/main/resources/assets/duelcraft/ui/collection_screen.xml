<?xml version="1.0" encoding="UTF-8"?>
<ldlib2-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Low-Drag-MC/LDLib2/refs/heads/1.21/ldlib2-ui.xsd">
    <stylesheet location="ldlib2:lss/gdp.lss" />
    <style>
        #collection-root { width: 1280; height: 720; }
        #collection-canvas { width: 100%; height: 100%; padding-all: 12; gap-all: 8; background: built-in(ui-gdp:BORDER_THICK_RT1); }
        label, text { font-size: 12; text-color: #FFFFFF; text-shadow: true; }
        button { height: 30; flex-shrink: 0; background: built-in(ui-gdp:RECT); }
        button text { font-size: 12; text-color: #ffffff; }
        selector text, selector label { text-color: #ffffff; }
        text-field, selector { height: 30; flex-shrink: 0; }
        .row { flex-direction: row; gap-all: 6; align-items: center; }
        .grow { flex: 1; min-width: 0; min-height: 0; }
        .wrap { text-wrap: wrap; adaptive-height: true; width: 100%; }
        .muted { text-color: #AAAAAA; }
        .heading { font-size: 16; height: 20; flex-shrink: 0; }
        #editor-header { height: 56; flex-shrink: 0; flex-direction: row; gap-all: 12; align-items: center; }
        #header-title { flex: 1; gap-all: 3; }
        #header-title label { height: 14; }
        #editor-title { height: 22; }
        #save-deck { width: 182; height: 36; }
        #sample-label { width: 230; text-wrap: wrap; adaptive-height: true; text-color: #AAAAAA; }
        #saved-lists { width: 110; }
        #lists-dialog, #delete-dialog { position: absolute; left: 0; top: 0; width: 100%; height: 100%; align-items: center; justify-content: center; background: rect(#96000000); z-index: 90; }
        #delete-dialog { z-index: 110; }
        #lists-panel { width: 620; padding-all: 20; gap-all: 12; background: built-in(ui-gdp:BORDER_THICK_RT1); }
        #lists-panel .row button { flex: 1; min-width: 0; }
        #list-picker, #list-name { width: 100%; }
        #delete-panel { width: 480; padding-all: 20; gap-all: 14; background: built-in(ui-gdp:BORDER_THICK_RT1); }
        #delete-panel button { flex: 1; }
        #editor-body { flex: 1; min-height: 0; flex-direction: row; gap-all: 12; }
        #card-inspector { width: 224; flex-shrink: 0; padding-all: 10; gap-all: 6; background: built-in(ui-gdp:RECT); }
        #card-details-scroll { flex: 1; min-height: 0; }
        #card-details-scroll .__scroller_view_view-container__ { gap-all: 8; }
        #inspector-art { height: 174; align-items: center; flex-shrink: 0; }
        .inspector-card { width: 118; height: 172; }
        #inspector-name { font-size: 16; text-color: #FFFF00; }
        #inspector-stats { text-color: #CCCCCC; }
        #inspector-description { font-size: 13; }
        #inspector-owned, #inspector-used, #inspector-missing { height: 18; }
        #inspector-missing { text-color: #FFDD55; }
        #card-edit-controls { flex-shrink: 0; gap-all: 4; }
        #card-edit-controls .row button { flex: 1; min-width: 0; }
        #add-card, #remove-card { height: 34; }
        #deck-sections { flex: 1; min-width: 0; min-height: 0; gap-all: 8; }
        .deck-section { min-height: 0; background: built-in(ui-gdp:RECT_LIGHT); }
        #main-section { flex: 1; min-height: 0; }
        #extra-section { height: 128; flex-shrink: 0; }
        #side-section { height: 32; flex-shrink: 0; }
        .section-header { height: 30; flex-shrink: 0; flex-direction: row; align-items: center; padding-horizontal: 8; background: built-in(ui-gdp:RECT); }
        .section-header label { flex: 1; }
        #toggle-side { width: 90; height: 24; }
        .deck-grid { flex: 1; min-height: 0; }
        .deck-grid .__scroller_view_view-container__ { display: grid; grid-template-columns: repeat(10, 54px); grid-auto-rows: 79px; gap-all: 4; justify-content: space_between; align-content: flex_start; }
        .large .deck-grid .__scroller_view_view-container__ { grid-template-columns: repeat(8, 70px); grid-auto-rows: 103px; }
        .deck-card { width: 54; height: 79; }
        .large .deck-card { width: 70; height: 103; }
        .card-tile { padding-all: 2; flex-shrink: 0; background: built-in(ui-gdp:RECT_RD_DARK); }
        .card-art { width: 100%; height: 100%; justify-content: center; align-items: center; overflow: hidden; background: built-in(ui-gdp:RECT); }
        .card-placeholder { width: 100%; text-wrap: wrap; adaptive-height: true; horizontal-align: center; font-size: 10; text-color: #DDDDDD; padding-all: 3; }
        .selected { overlay: rect(#6600FF00); }
        .missing-copy { position: absolute; bottom: 2; left: 2; right: 2; height: 13; font-size: 9; text-color: #000000; text-shadow: false; horizontal-align: center; background: rect(#CCFFAA00); }
        #collection-pane { width: 348; flex-shrink: 0; min-height: 0; gap-all: 6; }
        #collection-search { flex: 1; min-width: 0; }
        #toggle-filters { width: 104; }
        #collection-options selector { flex: 1; min-width: 0; }
        #active-filters { height: 48; flex-shrink: 0; }
        #active-filters .__scroller_view_view-container__ { flex-direction: row; flex-wrap: wrap; gap-all: 4; }
        .filter-chip { height: 24; padding-horizontal: 4; }
        .filter-chip text { font-size: 10; }
        #browse-results { flex: 1; min-height: 0; gap-all: 4; }
        #collection-results-host { flex: 1; min-height: 0; }
        #collection-results { flex: 1; min-height: 0; scroller-view-mode: vertical; scroller-vertical-display: always; scroller-horizontal-display: never; }
        .collection-row { height: 128; width: 100%; flex-direction: row; gap-all: 6; flex-shrink: 0; }
        .collection-cell { width: 74; height: 128; flex-shrink: 0; gap-all: 3; }
        .collection-card { width: 74; height: 108; }
        .collection-caption { width: 74; height: 14; font-size: 10; horizontal-align: center; }
        #collection-empty { height: 40; text-wrap: wrap; horizontal-align: center; }
        #filter-panel { flex: 1; min-height: 0; padding-all: 8; gap-all: 6; background: built-in(ui-gdp:RECT); }
        #filter-scroll { flex: 1; min-height: 0; }
        #filter-groups { gap-all: 6; }
        .filter-heading { width: 100%; height: 22; padding-top: 5; }
        .filter-choices { flex-direction: row; flex-wrap: wrap; gap-all: 4; }
        .filter-choice { height: 28; padding-horizontal: 6; }
        .filter-choice text { font-size: 11; }
        #filter-apply { height: 34; }
        .range-row { flex-direction: row; gap-all: 6; height: 32; flex-shrink: 0; }
        .range-row text-field { flex: 1; min-width: 0; }
        #filter-measure { width: 100%; }
        #editor-footer { height: 36; flex-shrink: 0; flex-direction: row; align-items: center; gap-all: 8; }
        #card-density { width: 158; }
        #card-density text { adaptive-width: false; width: 100%; }
        #deck-warnings { flex: 1; min-width: 0; font-size: 11; text-wrap: wrap; adaptive-height: true; text-color: #FFDD55; }
        #editor-status { height: 18; flex-shrink: 0; font-size: 12; }
        #status-row { height: 18; flex-shrink: 0; }
        #editor-status { flex: 1; min-width: 0; }
        #eligibility-details { width: 94; height: 18; }
        #eligibility-dialog { position: absolute; left: 0; top: 0; width: 100%; height: 100%; align-items: center; justify-content: center; background: rect(#96000000); z-index: 96; }
        #eligibility-panel { width: 620; height: 420; padding-all: 20; gap-all: 12; background: built-in(ui-gdp:BORDER_THICK_RT1); }
        #eligibility-scroll { flex: 1; min-height: 0; }
        #eligibility-scroll .__scroller_view_view-container__ { gap-all: 10; }
        scroller-view { scroller-view-mode: vertical; scroller-vertical-display: always; scroller-horizontal-display: never; adaptive-height: false; adaptive-width: false; }
        .__scroller_view_view-port__ { padding-all: 3; background: rect(#00000000); }
        .__scroller_view_vertical-scroller__ { width: 10; }
        #close-dialog { position: absolute; left: 0; top: 0; width: 100%; height: 100%; align-items: center; justify-content: center; background: rect(#96000000); z-index: 100; }
        #close-panel { width: 460; padding-all: 20; gap-all: 14; background: built-in(ui-gdp:BORDER_THICK_RT1); }
        #close-panel label { text-color: #ffffff; }
        #close-panel button { flex: 1; }
    </style>
    <root id="collection-root">
        <element id="collection-canvas">
            <element id="editor-header">
                <element id="header-title">
                    <label class="muted">DUELCRAFT / DECK BUILDER</label>
                    <label id="editor-title" class="heading">duelcraft.collection.title</label>
                    <label id="deck-summary" />
                </element>
                <label id="sample-label">duelcraft.collection.sample</label>
                <button id="saved-lists" text="duelcraft.collection.lists" />
                <button id="save-deck" text="duelcraft.collection.save" />
            </element>
            <element id="editor-body">
                <element id="card-inspector">
                    <scroller-view id="card-details-scroll">
                        <element id="inspector-art" />
                        <label id="inspector-name" class="wrap" />
                        <label id="inspector-stats" class="wrap" />
                        <text id="inspector-description" class="wrap" />
                        <button id="withdraw-card" text="Withdraw · unavailable" />
                    </scroller-view>
                    <element id="card-edit-controls">
                        <label id="inspector-owned" />
                        <label id="inspector-used" />
                        <label id="inspector-missing" />
                        <label>Add to / remove from</label>
                        <element class="row">
                            <button id="section-main" text="Main" />
                            <button id="section-extra" text="Extra" />
                            <button id="section-side" text="Side" />
                        </element>
                        <element class="row">
                            <button id="add-card" text="+1 Add" />
                            <button id="remove-card" text="−1 Remove" />
                        </element>
                    </element>
                </element>
                <element id="deck-sections">
                    <element id="main-section" class="deck-section">
                        <element id="main-header" class="section-header"><label id="main-count" /></element>
                        <scroller-view id="main-grid" class="deck-grid" />
                    </element>
                    <element id="extra-section" class="deck-section">
                        <element id="extra-header" class="section-header"><label id="extra-count" /></element>
                        <scroller-view id="extra-grid" class="deck-grid" />
                    </element>
                    <element id="side-section" class="deck-section">
                        <element id="side-header" class="section-header"><label id="side-count" /><button id="toggle-side" text="Expand" /></element>
                        <scroller-view id="side-grid" class="deck-grid" />
                    </element>
                </element>
                <element id="collection-pane">
                    <label class="heading">Card collection</label>
                    <element class="row">
                        <text-field id="collection-search" />
                        <button id="toggle-filters" text="Filters" />
                    </element>
                    <label class="muted">Name, effect text or exact passcode</label>
                    <element id="collection-options" class="row">
                        <selector id="collection-ownership" />
                        <selector id="card-sort" />
                    </element>
                    <scroller-view id="active-filters" />
                    <element id="browse-results">
                        <label id="result-count" />
                        <element id="collection-results-host" />
                        <label id="collection-empty">No matching cards. Open Filters to clear.</label>
                    </element>
                    <element id="filter-panel">
                        <element class="row"><label class="grow">Filter cards</label><button id="filter-clear" text="Clear all" /></element>
                        <scroller-view id="filter-scroll">
                            <element id="filter-groups" />
                            <label class="filter-heading">Level / Rank / Link</label>
                            <selector id="filter-measure" />
                            <label>Number minimum / maximum</label>
                            <element class="range-row"><text-field id="filter-measure-min" /><text-field id="filter-measure-max" /></element>
                            <label>ATK minimum / maximum</label>
                            <element class="range-row"><text-field id="filter-atk-min" /><text-field id="filter-atk-max" /></element>
                            <label>DEF minimum / maximum</label>
                            <element class="range-row"><text-field id="filter-def-min" /><text-field id="filter-def-max" /></element>
                            <label>Pendulum scale minimum / maximum</label>
                            <element class="range-row"><text-field id="filter-scale-min" /><text-field id="filter-scale-max" /></element>
                        </scroller-view>
                        <button id="filter-apply" text="Apply filters" />
                    </element>
                </element>
            </element>
            <element id="editor-footer">
                <button id="deposit-cards" text="Deposit · unavailable" />
                <button id="activate-deck" text="Activate · unavailable" />
                <label id="deck-warnings" />
                <button id="card-density" text="Cards: Standard" />
            </element>
            <element id="status-row" class="row">
                <label id="editor-status">duelcraft.collection.unavailable</label>
                <button id="eligibility-details" />
            </element>
            <element id="eligibility-dialog">
                <element id="eligibility-panel">
                    <label id="eligibility-title" class="heading" />
                    <label id="eligibility-summary" class="wrap" />
                    <scroller-view id="eligibility-scroll" />
                    <button id="eligibility-close" />
                </element>
            </element>
            <element id="lists-dialog">
                <element id="lists-panel">
                    <label id="lists-title" class="heading">duelcraft.collection.lists</label>
                    <selector id="list-picker" />
                    <label id="list-name-label">duelcraft.collection.list_name</label>
                    <text-field id="list-name" />
                    <label id="list-active-status" />
                    <element class="row">
                        <button id="list-new" text="duelcraft.collection.new" />
                        <button id="list-rename" text="duelcraft.collection.rename" />
                        <button id="list-duplicate" text="duelcraft.collection.duplicate" />
                        <button id="list-delete" text="duelcraft.collection.delete" />
                    </element>
                    <element class="row">
                        <button id="list-activate" text="duelcraft.collection.activate" />
                        <button id="list-clear-active" text="duelcraft.collection.clear_active" />
                        <button id="list-refresh" text="duelcraft.collection.refresh" />
                        <button id="lists-close" text="duelcraft.collection.done" />
                    </element>
                    <label id="list-supported-checks" class="wrap muted">duelcraft.collection.supported_checks</label>
                    <label id="list-save-first" class="wrap muted">duelcraft.collection.save_first</label>
                </element>
            </element>
            <element id="delete-dialog">
                <element id="delete-panel">
                    <label id="delete-title" class="heading">duelcraft.collection.delete_confirm</label>
                    <label id="delete-copy" class="wrap">duelcraft.collection.delete_copy</label>
                    <element class="row">
                        <button id="delete-confirm" text="duelcraft.collection.delete" />
                        <button id="delete-cancel" text="duelcraft.collection.cancel" />
                    </element>
                </element>
            </element>
            <element id="close-dialog">
                <element id="close-panel">
                    <label id="close-title" class="heading">duelcraft.collection.save_changes</label>
                    <label id="close-copy" class="wrap">duelcraft.collection.save_changes_copy</label>
                    <element class="row">
                        <button id="close-save" text="Save" />
                        <button id="close-discard" text="Discard" />
                        <button id="close-cancel" text="Cancel" />
                    </element>
                </element>
            </element>
        </element>
    </root>
</ldlib2-ui>
