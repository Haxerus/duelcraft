    <root id="collection-root">
        <element id="collection-canvas" class="gallery-management">
            <element id="editor-header">
                <element id="header-title">
                    <label id="editor-title" class="heading">My Collection</label>
                    <text-field id="list-name" />
                </element>
                <element id="header-spacer" />
                <element id="header-state">
                    <element id="header-state-labels"><label id="list-active-status" /><label id="deck-summary" /></element>
                    <button class="gallery-action" id="list-clear-active" text="duelcraft.collection.clear_active" />
                </element>
                <button class="gallery-action gallery-primary" id="save-deck" text="duelcraft.collection.save" />
                <button class="gallery-action" id="activate-deck" text="duelcraft.collection.use_for_duels" />
            </element>
            <element id="editor-nav">
                <button class="gallery-action" id="collection-back" text="Back" style="display: none; width: 72;" />
                <button class="gallery-action" id="new-deck" text="duelcraft.collection.new_deck" />
                <button class="gallery-action" id="saved-lists" text="duelcraft.collection.lists" />
                <button class="gallery-action" id="import-export" text="duelcraft.collection.import_export" />
                <button class="gallery-action" id="help-button" text="?" />
                <button class="gallery-action" id="close-editor" text="duelcraft.collection.close" />
            </element>
            <element id="editor-body">
                <element id="card-inspector">
                    <element id="inspector-empty">
                        <element id="inspector-empty-back" />
                        <label id="inspector-empty-prompt" />
                    </element>
                    <scroller-view id="card-details-scroll">
                        <element id="inspector-art" />
                        <label id="inspector-name" class="wrap" />
                        <label id="inspector-stats" class="wrap" />
                        <text id="inspector-description" class="wrap" />
                    </scroller-view>
                    <element id="card-edit-controls">
                        <label id="inspector-owned" />
                        <label id="inspector-carried" />
                        <label id="inspector-used" />
                        <label id="inspector-missing" />
                        <element class="row"><label id="transfer-amount-label" class="grow" /><text-field id="transfer-amount" /></element>
                        <element id="transfer-actions" class="row">
                            <button class="gallery-action" id="deposit-card" text="duelcraft.collection.deposit" />
                            <button class="gallery-action" id="withdraw-card" text="duelcraft.collection.withdraw" />
                        </element>
                        <element class="row">
                            <button id="section-deck" class="gallery-action mode-button" text="Deck" />
                            <button id="section-side" class="gallery-action mode-button" text="Side" />
                        </element>
                        <element class="row">
                            <button class="gallery-action" id="add-card" text="+1 Add" />
                            <button class="gallery-action" id="remove-card" text="−1 Remove" />
                        </element>
                    </element>
                </element>
                <element id="deck-sections">
                    <element id="main-section" class="deck-section">
                        <element id="main-header" class="section-header"><label id="main-count" /><button class="gallery-action" id="sort-deck" /><button class="gallery-action" id="card-density" text="Cards: Standard" /></element>
                        <scroller-view id="main-grid" class="deck-grid" />
                    </element>
                    <element id="gallery-lower-decks">
                    <element id="extra-section" class="deck-section">
                        <element id="extra-header" class="section-header"><label id="extra-count" /></element>
                        <scroller-view id="extra-grid" class="deck-grid" />
                    </element>
                    <element id="side-section" class="deck-section">
                        <element id="side-header" class="section-header"><label id="side-count" /><button class="gallery-action" id="toggle-side" text="Expand" /></element>
                        <scroller-view id="side-grid" class="deck-grid" />
                    </element>
                    </element>
                </element>
                <element id="collection-pane">
                    <label class="heading">Card collection</label>
                    <element class="row">
                        <text-field id="collection-search" />
                        <button class="gallery-action" id="toggle-filters" text="Filters" />
                    </element>
                    <element id="collection-options" class="row">
                        <selector id="collection-ownership" />
                        <selector id="card-sort" />
                    </element>
                    <scroller-view id="active-filters" />
                    <button id="alternate-formats" class="gallery-action mode-button" text="Alternate formats: Off" />
                    <element id="browse-results">
                        <label id="result-count" />
                        <element id="collection-results-host" />
                        <label id="collection-empty">No matching cards. Open Filters to clear.</label>
                    </element>
                    <element id="filter-panel">
                        <element class="row"><label class="grow">Filter cards</label><button class="gallery-action" id="filter-clear" text="Clear all" /></element>
                        <scroller-view id="filter-scroll">
                            <element id="filter-groups" />
                            <label class="filter-heading">Level / Rank / Link</label>
                            <selector id="filter-measure" />
                            <label>Number minimum / maximum</label>
                            <element class="range-row"><text-field id="filter-measure-min" /><text-field id="filter-measure-max" /></element>
                            <label>ATK minimum / maximum</label>
                            <element class="range-row"><text-field id="filter-atk-min" /><text-field id="filter-atk-max" /></element>
                            <label>DEF minimum / maximum</label>
                            <element class="range-row"><text-field id="filter-def-min" /><text-field id="filter-def-max" /></element>
                            <label>Pendulum scale minimum / maximum</label>
                            <element class="range-row"><text-field id="filter-scale-min" /><text-field id="filter-scale-max" /></element>
                        </scroller-view>
                        <button class="gallery-action" id="filter-apply" text="Apply filters" />
                    </element>
                </element>
            </element>
            <element id="editor-footer">
                <button class="gallery-action" id="deposit-cards" text="duelcraft.collection.deposit_all" />
                <element id="deck-feedback">
                    <label id="deck-warnings" />
                    <label id="deck-shortages" />
                </element>
            </element>
            <element id="status-row" class="row">
                <label id="editor-status">duelcraft.collection.unavailable</label>
                <button class="gallery-action" id="eligibility-details" />
            </element>
            <element id="eligibility-dialog">
                <element id="eligibility-panel">
                    <label id="eligibility-title" class="heading" />
                    <label id="eligibility-summary" class="wrap" />
                    <scroller-view id="eligibility-scroll" />
                    <button class="gallery-action" id="eligibility-close" />
                </element>
            </element>
            <element id="lists-dialog">
                <element id="lists-panel">
                    <element class="row"><label id="lists-title" class="heading grow">duelcraft.collection.lists</label><button class="gallery-action" id="lists-close" text="X" /></element>
                    <scroller-view id="saved-list-scroll" />
                    <element class="row list-actions">
                        <button class="gallery-action" id="list-open" text="duelcraft.collection.open" />
                        <button class="gallery-action" id="list-duplicate" text="duelcraft.collection.duplicate" />
                        <button class="gallery-action" id="list-delete" text="duelcraft.collection.delete" />
                    </element>
                </element>
            </element>
            <element id="import-dialog">
                <element id="import-panel">
                    <element class="row"><label id="import-title" class="heading grow" /><button class="gallery-action" id="import-close" text="X" /></element>
                    <element id="import-choice-row"><selector id="list-import-picker" /><button class="gallery-action" id="list-import" text="duelcraft.collection.import_ydk" /></element>
                    <button class="gallery-action" id="list-export" text="duelcraft.collection.export_ydk" />
                </element>
            </element>
            <element id="help-dialog">
                <element id="help-panel">
                    <label id="help-title" class="heading" />
                    <label id="help-controls" class="wrap" />
                    <label id="help-navigation" class="wrap" />
                    <label id="help-ownership" class="wrap" />
                    <label id="help-supported-checks" class="wrap" />
                    <button class="gallery-action" id="help-close" text="duelcraft.collection.done" />
                </element>
            </element>
            <element id="delete-dialog">
