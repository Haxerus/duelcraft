<?xml version="1.0" encoding="UTF-8"?>
<ldlib2-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Low-Drag-MC/LDLib2/refs/heads/1.21/ldlib2-ui.xsd">
    <stylesheet location="ldlib2:lss/gdp.lss" />
    <style>
        /* ── Root: fixed design canvas. DuelScreen scales #duel-canvas to the window. ── */
        #duel-root {
        width: 960;
        height: 540;
        }

        #duel-canvas {
        flex-direction: column;
        width: 100%;
        height: 100%;
        }

        /* ── Field Area ── */
        #field-area {
        flex-direction: column;
        justify-content: center;
        align-items: center;
        align-self: center;
        gap-all: 2;
        padding-all: 8;
        margin-vertical: 8;
        background: built-in(ui-gdp:BORDER_THICK_RT1)
        }

        .field-bg-half {
        position: absolute;
        left: 0;
        width: 100%;
        height: 50%;
        display: none;
        }

        #field-bg-opp {
        top: 0;
        background: sprite(minecraft:textures/block/dirt.png);
        }

        #field-bg-plr {
        bottom: 0;
        background: sprite(minecraft:textures/block/magma.png);
        }

        /* ── Player Side Containers ── */
        .player-side {
        flex-direction: row;
        align-items: center;
        gap-all: 2;
        }

        #opponent-side {
        flex-direction: row_reverse;
        }

        #opp-st-row {
        flex-direction: row_reverse;
        }

        #opp-mon-row {
        flex-direction: row_reverse;
        }

        #opponent-side .zone-icon {
        transform: rotate(180);
        }

        #opponent-side .card {
        transform: rotate(180);
        }

        /* ── Pile Columns (left/right of zones) ── */
        .pile-column {
        flex-direction: column;
        align-items: center;
        gap-all: 2;
        padding-horizontal: 4;
        }

        .pz-slot {
        background: built-in(ui-gdp:RECT_RD_DARK);
        }

        /* ── Zone Grid (rectangle background behind zones) ── */
        .zone-grid {
        flex-direction: column;
        align-items: center;
        gap-all: 2;
        padding-all: 4;
        background: built-in(ui-gdp:RECT_RD_DARK);
        }

        /* ── Zone Rows Container ── */
        .zone-rows {
        flex-direction: column;
        align-items: center;
        gap-all: 2;
        }

        /* ── A single row of 5 zones ── */
        .zone-row {
        flex-direction: row;
        gap-all: 2;
        }

        /* ── Card slot (zone container with card proportions) ── */
        .card-slot {
        min-width: 36;
        min-height: 48;
        aspect-rate: 0.75;
        align-items: center;
        justify-content: center;
        }

        /* ── Unified card element (programmatic cards in hand/inspector/field) ── */
        .card {
        min-width: 36;
        min-height: 48;
        aspect-rate: 0.75;
        align-items: center;
        justify-content: center;
        transition: background 0.3 quad_in_out,
        transform 0.2;
        }

        /* ── Square slot ── */
        .square-slot {
        min-width: 48;
        min-height: 48;
        aspect-rate: 1;
        align-items: center;
        justify-content: center;
        background: rect(#16000000);
        }

        .zone-icon {
        width: 16;
        height: 16;
        }

        .zone-icon.hidden {
        display: none;
        }

        .zone-slot {
        //background: rect(#20ffffff);
        }

        .pile-slot {
        background: built-in(ui-gdp:RECT_RD_DARK);
        }

        .emz-slot {
        background: built-in(ui-gdp:RECT_RD_DARK);
        }

        /* ── Center Row (EMZ + Controls) ── */
        #center-row {
        flex-direction: row;
        align-items: center;
        justify-content: space_between;
        align-self: stretch;
        }

        #center-controls {
        flex-direction: row;
        align-items: center;
        gap-all: 14;
        }

        /* ── Phase buttons ── */

        .phase-btn {
        width: 24;
        height: 24;
        }

        .phase-btn.hidden {
        opacity: 0;
        }

        /* Shuffle hand (SELECT_IDLECMD, canShuffle). Hidden with display:none so the
           center row keeps its usual width whenever the engine does not offer it. */
        #shuffle-btn {
        width: 40;
        height: 14;
        }

        #shuffle-btn.hidden {
        display: none;
        }

        /* ── Status Label (centered overlay) ── */
        #status-label {
        position: absolute;
        bottom: 50;
        left: 0;
        width: 100%;
        font-size: 8;
        text-color: #FFAA00;
        horizontal-align: center;
        padding-vertical: 2;
        background: rect(#aa000000);
        }

        #status-label.hidden {
        display: none;
        }

        /* ── Hint toast (edopro's stACMessage: one declaration hint at a time) ── */
        #toast {
        position: absolute;
        top: 26;
        left: 0;
        width: 100%;
        font-size: 8;
        text-color: #FFDD55;
        horizontal-align: center;
        padding-vertical: 2;
        background: rect(#aa000000);
        }

        #toast.hidden {
        display: none;
        }

        /* ── Chain depth, on its own row so prompt captions keep the status label ── */
        #chain-count {
        position: absolute;
        bottom: 62;
        left: 0;
        width: 100%;
        font-size: 8;
        text-color: #FF88FF;
        horizontal-align: center;
        }

        #chain-count.hidden {
        display: none;
        }

        /* ── Turn and phase banner (edopro's showcard 101 / phase card, about a second) ──
           Below the field, above the chain count, so it covers no card and no button. */
        #banner {
        position: absolute;
        bottom: 80;
        left: 0;
        width: 100%;
        font-size: 14;
        text-color: #FFFFFF;
        horizontal-align: center;
        padding-vertical: 3;
        background: rect(#aa000000);
        }

        #banner.hidden {
        display: none;
        }

        /* ── Floating LP number, under the LP bar of the player it belongs to.
           Above the side panels, which both start at the same top edge. ── */
        .lp-delta {
        position: absolute;
        top: 21;
        width: 30%;
        font-size: 12;
        horizontal-align: center;
        z-index: 5;
        }

        .lp-delta.lp-left {
        left: 4;
        }

        .lp-delta.lp-right {
        right: 4;
        }

        .lp-delta.lp-damage {
        text-color: #FF4444;
        }

        .lp-delta.lp-recover {
        text-color: #44FF44;
        }

        .lp-delta.lp-cost {
        text-color: #6699FF;
        }

        .lp-delta.hidden {
        display: none;
        }

        /* ── Duel log (over the card info banner, toggled from the HUD) ── */
        #duel-log {
        position: absolute;
        left: 0;
        top: 20;
        bottom: 0;
        width: 210;
        flex-direction: column;
        gap-all: 2;
        padding-all: 4;
        background: built-in(ui-gdp:RECT);
        }

        #duel-log.hidden {
        width: 0;
        overflow: hidden;
        display: none;
        }

        #duel-log-title {
        height: 12;
        font-size: 9;
        text-color: #FFFFFF;
        }

        #duel-log-list {
        flex: 1;
        }

        #duel-log-list .__scroller_view_view-container__ {
        flex-direction: column;
        gap-all: 1;
        padding-all: 2;
        }

        .log-line {
        width: 100%;
        adaptive-height: true;
        text-wrap: wrap;
        font-size: 7;
        text-color: #DDDDDD;
        }

        #log-toggle {
        width: 28;
        height: 14;
        }

        /* ── Refcounted player hints (MSG_PLAYER_HINT), under each player's name ── */
        .player-hints {
        position: absolute;
        top: 20;
        width: 30%;
        font-size: 6;
        text-color: #FFDD55;
        }

        #plr-hints {
        left: 4;
        horizontal-align: left;
        }

        #opp-hints {
        right: 4;
        horizontal-align: right;
        }

        /* ── Shared Cancel/Finish button (edopro's btnCancelOrFinish) ── */
        #prompt-action-bar {
        position: absolute;
        bottom: 32;
        left: 0;
        width: 100%;
        flex-direction: row;
        justify-content: center;
        }

        .prompt-btn.hidden {
        display: none;
        }

        /* ── Card count label ── */
        .card-count {
        position: absolute;
        bottom: 1;
        left: 0;
        width: 100%;
        font-size: 7;
        text-color: #FFFFFF;
        horizontal-align: center;
        vertical-align: bottom;
        background: rect(#77000000);
        }

        /* ── Card back ── */
        .card-back {
        background: sprite(duelcraft:textures/card_back.png);
        height: 48;
        aspect-rate: 0.75;
        }

        /* ── Monster stat labels ── */
        .stat-atk-def {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        font-size: 6;
        horizontal-align: center;
        vertical-align: center;
        background: rect(#cc000000);
        text-color: #FFFFFF;
        }

        .stat-level {
        position: absolute;
        top: 0;
        right: 0;
        font-size: 5;
        background: rect(#cc000000);
        text-color: #FFFFFF;
        padding-horizontal: 1;
        }

        /* ── XYZ material count badge (sits just above the ATK/DEF bar) ── */
        .card-materials {
        position: absolute;
        bottom: 7;
        left: 0;
        font-size: 5;
        background: rect(#CC5522AA);
        text-color: #FFFFFF;
        padding-horizontal: 1;
        }

        /* ── Counter total badge ── */
        .card-counters {
        position: absolute;
        top: 0;
        left: 0;
        font-size: 5;
        background: rect(#CCCC7700);
        text-color: #FFFFFF;
        padding-horizontal: 1;
        }

        /* ── Turn-count badge (MSG_CARD_HINT CHINT_TURN) ── */
        .card-turns {
        position: absolute;
        bottom: 7;
        right: 0;
        font-size: 5;
        background: rect(#CC227755);
        text-color: #FFFFFF;
        padding-horizontal: 1;
        }

        /* ── Pendulum scale badge (left/right scale of a card in a pendulum zone) ── */
        .card-scales {
        position: absolute;
        top: 0;
        right: 0;
        font-size: 5;
        background: rect(#CC2266CC);
        text-color: #FFFFFF;
        padding-horizontal: 1;
        }

        /* Opponent's stat labels — positions mirror the flipped card (text stays upright) */
        .stat-atk-def.opp {
        bottom: auto;
        top: 0;
        }

        .stat-level.opp {
        top: auto;
        bottom: 0;
        }

        .stat-buffed {
        text-color: #55FF55;
        }

        .stat-debuffed {
        text-color: #FF5555;
        }

        /* ── Defense position ── */
        .defense {
        transform: rotate(90);
        }

        #opponent-side .defense {
        transform: rotate(270);
        }

        /* Opponent-owned EMZ cards (EMZ slots live outside #opponent-side) */
        .emz-opp {
        transform: rotate(180);
        }

        .emz-opp.defense {
        transform: rotate(270);
        }

        /* Opponent's pile slots — rotate the card image when showing one */
        #opp-graveyard.has-card,
        #opp-banished.has-card,
        #opp-extra-deck.has-card {
        transform: rotate(180);
        }

        /* Opponent pile count labels — always at visual top for consistency,
           regardless of whether the pile is rotated */
        #opp-deck .card-count,
        #opp-graveyard .card-count,
        #opp-banished .card-count,
        #opp-extra-deck .card-count {
        top: 1;
        bottom: auto;
        }

        /* When the pile is rotated 180°, CSS-top visually becomes bottom.
           Flip the label to CSS-bottom and counter-rotate so text reads upright at visual top. */
        #opp-graveyard.has-card .card-count,
        #opp-banished.has-card .card-count,
        #opp-extra-deck.has-card .card-count {
        top: auto;
        bottom: 1;
        transform: rotate(180);
        }

        /* ── Hand Row ── */
        #player-hand .card.__hovered__ {
        transform: scale(1.05);
        }

        .hand-row {
        align-self: stretch;
        scroller-view-mode: HORIZONTAL;
        scroller-horizontal-display: ALWAYS;
        }

        #opponent-hand .__scroller_view_view-container__ {
        flex-direction: row;
        gap-all: 2;
        }

        #player-hand .__scroller_view_view-container__ {
        flex-direction: row;
        gap-all: 2;
        }

        #opponent-hand .__scroller_view_view-port__, #player-hand .__scroller_view_view-port__ {
        background: built-in(ui-gdp:RECT_LIGHT);
        min-height: 42;
        }

        /* ── HUD Bar (absolute overlay at top) ── */
        #hud-bar {
        width: 100%;
        height: 20;
        flex-direction: row;
        align-items: center;
        gap-all: 4;
        padding-left: 4;
        padding-right: 4;
        background: rect(#88000000);
        }

        .lp-bar {
        flex: 1;
        height: 18;
        }

        .__progress-bar_bar__ {
        background: rect(#ff00ff00);
        }

        #hud-info {
        flex-direction: column;
        width: 40%;
        }

        #duel-title-label {
        font-size: 8;
        text-color: #FFFFFF;
        horizontal-align: center;
        }

        #hud-turn-phase {
        font-size: 7;
        text-color: #AAAAAA;
        horizontal-align: center;
        }

        #concede-btn {
        width: 44;
        height: 14;
        }
        /* ── Card Info Banner (left overlay) ── */
        #card-info-banner {
        position: absolute;
        left: 0;
        top: 20;
        bottom: 0;
        width: 210;
        flex-direction: column;
        gap-all: 2;
        padding-all: 4;
        background: built-in(ui-gdp:RECT);
        }

        #card-info-banner.hidden {
        width: 0;
        overflow: hidden;
        display: none;
        }

        #card-image-area {
        width: 192;
        height: 192;
        align-self: center;
        //background: rect(#3c3c50);
        background: sprite(duelcraft:textures/test.png);
        }

        .card-label {
        adaptive-height: true;
        text-wrap: wrap;
        }

        #card-name-label {
        height: 10;
        font-size: 9;
        text-color: #FFFF00;
        horizontal-align: center;
        }

        #card-stats-label {
        height: 10;
        font-size: 8;
        text-color: #CCCCCC;
        horizontal-align: center;
        }

        #card-atk-def-label {
        horizontal-align: center;
        }

        /* Card hints (MSG_CARD_HINT) below the stats, as edopro's tooltip lines */
        #card-hints {
        horizontal-align: center;
        text-color: #FFDD55;
        text-wrap: wrap;
        adaptive-height: true;
        }

        #card-hints.hidden {
        display: none;
        }

        #card-text-scroll {
        flex: 1;
        }

        #card-text {
        flex: 1;
        text-wrap: wrap;
        adaptive-height: true;
        }

        /* ── Zone Inspector (right overlay) ── */
        #zone-inspector {
        position: absolute;
        right: 0;
        top: 20;
        bottom: 0;
        width: 210;
        flex-direction: column;
        gap-all: 2;
        padding-all: 4;
        background: built-in(ui-gdp:RECT);
        }

        #zone-inspector.hidden {
        width: 0;
        overflow: hidden;
        display: none;
        }

        #zone-inspector-title {
        height: 12;
        font-size: 9;
        text-color: #FFFFFF;
        }

        #zone-inspector-list {
        flex: 1;
        gap-all: 2;
        }

        #zone-inspector-list .__scroller_view_view-container__ {
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        gap-all: 2;
        padding-all: 2;
        }

        .insp-slot {
        flex-basis: 1;
        background: built-in(ui-gdp:RECT);
        }

        .inspector-card-entry {
        flex-direction: row;
        align-items: center;
        height: 20;
        gap-all: 2;
        padding-left: 2;
        }

        /* ── Prompt Dialog (centered overlay) ── */
        #prompt-overlay {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        align-items: center;
        justify-content: center;
        background: rect(#64000000);
        }

        #prompt-overlay.hidden {
        width: 0;
        height: 0;
        overflow: hidden;
        display: none;
        }

        #prompt-dialog {
        flex-direction: column;
        align-content: center;

        gap-all: 4;
        padding-all: 8;
        width: 200;
        background: rect(#1A1A2E, 4, 1, #4444AA);
        }

        #prompt-title {
        height: 12;
        font-size: 9;
        text-color: #FFFFFF;
        horizontal-align: center;
        }

        #prompt-body {
        flex-direction: column;
        align-items: center;
        gap-all: 2;
        width: 100%;
        }

        #prompt-buttons {
        flex-direction: row;
        justify-content: center;
        gap-all: 4;
        }

        .prompt-btn {
        width: 60;
        height: 16;
        }

        /* ── Horizontal card scroller inside prompt dialogs ── */
        .prompt-card-scroller {
        scroller-view-mode: HORIZONTAL;
        scroller-horizontal-display: ALWAYS;
        align-self: stretch;
        }

        .prompt-card-scroller .__scroller_view_view-container__ {
        flex-direction: row;
        gap-all: 2;
        }

        .prompt-card-scroller .__scroller_view_view-port__ {
        background: built-in(ui-gdp:RECT_LIGHT);
        min-height: 48;
        }

        /* ── Duel Result Overlay (shown when the duel ends) ── */
        #result-overlay {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        align-items: center;
        justify-content: center;
        background: rect(#96000000);
        }

        #result-overlay.hidden {
        width: 0;
        height: 0;
        overflow: hidden;
        display: none;
        }

        #result-dialog {
        flex-direction: column;
        align-items: center;
        gap-all: 4;
        padding-all: 8;
        width: 200;
        background: rect(#1A1A2E, 4, 1, #4444AA);
        }

        #result-title {
        height: 14;
        font-size: 12;
        text-color: #FFFFFF;
        horizontal-align: center;
        }

        #result-reason {
        height: 10;
        font-size: 8;
        text-color: #AAAAAA;
        horizontal-align: center;
        }

        /* ── Hint Modal (HINT_MESSAGE; above the prompts, below the pause dialog) ── */
        #hint-modal {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        align-items: center;
        justify-content: center;
        background: rect(#96000000);
        }

        #hint-modal.hidden {
        width: 0;
        height: 0;
        overflow: hidden;
        display: none;
        }

        #hint-modal-dialog {
        flex-direction: column;
        align-items: center;
        gap-all: 4;
        padding-all: 8;
        width: 200;
        background: rect(#1A1A2E, 4, 1, #4444AA);
        }

        #hint-modal-text {
        width: 100%;
        font-size: 8;
        text-color: #FFFFFF;
        horizontal-align: center;
        text-wrap: wrap;
        adaptive-height: true;
        }

        /* ── Pause Overlay (ESC while the duel is live; drawn above every other overlay) ── */
        #pause-overlay {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        align-items: center;
        justify-content: center;
        background: rect(#96000000);
        }

        #pause-overlay.hidden {
        width: 0;
        height: 0;
        overflow: hidden;
        display: none;
        }

        #pause-dialog {
        flex-direction: column;
        align-items: center;
        gap-all: 4;
        padding-all: 8;
        width: 200;
        background: rect(#1A1A2E, 4, 1, #4444AA);
        }

        #pause-title {
        height: 12;
        font-size: 9;
        text-color: #FFFFFF;
        horizontal-align: center;
        }

        #pause-buttons {
        flex-direction: row;
        justify-content: center;
        gap-all: 4;
        }

        /* ── Vertical name list inside prompt dialogs (ANNOUNCE_CARD search) ── */
        .prompt-name-scroller {
        scroller-view-mode: VERTICAL;
        scroller-vertical-display: ALWAYS;
        align-self: stretch;
        }

        .prompt-name-scroller .__scroller_view_view-container__ {
        flex-direction: column;
        gap-all: 1;
        }

        .prompt-name-scroller .__scroller_view_view-port__ {
        background: built-in(ui-gdp:RECT_LIGHT);
        height: 80;
        }

        .prompt-name-btn {
        align-self: stretch;
        height: 12;
        padding-all: 1;
        }

        .prompt-name-btn .__button_text__ {
        font-size: 7;
        }

        /* ── Battle position choices (SELECT_POSITION card-image buttons) ── */
        .position-row {
        flex-direction: row;
        gap-all: 2;
        }

        .position-choice {
        flex-direction: column;
        align-items: center;
        width: 42;
        gap-all: 1;
        }

        /* A defense choice is the same card rotated 90°, so the column has to be wide
           enough for the card's long edge. */
        .position-choice .card {
        min-width: 26;
        min-height: 35;
        }

        .position-label {
        font-size: 6;
        text-color: #FFFFFF;
        horizontal-align: center;
        }

        /* ── Sort ordinal badge (SortCard/SortChain) ── */
        .card-ordinal {
        position: absolute;
        top: 0;
        left: 0;
        font-size: 8;
        background: rect(#CC0000FF);
        text-color: #FFFFFF;
        padding-horizontal: 2;
        }

        .target {
        overlay: rect(#6600FFFF);
        }

        .selectable {
        overlay: rect(#66FF4444);
        }

        .selected {
        overlay: rect(#6600FF00);
        }

        /* Targeted by an effect (MSG_BECOME_TARGET / MSG_CARD_SELECTED / MSG_CARD_TARGET) */
        .targeted {
        overlay: rect(#66FF00FF);
        }

        /* Zone the engine has disabled (MSG_FIELD_DISABLED) */
        .disabled {
        overlay: rect(#99202020);
        }

        /* Zone a HINT_ZONE is pointing at, for about a second */
        .flash {
        overlay: rect(#88FFFF00);
        }

        /* ── Battle: the two ends of an attack, for about a second and a half ── */
        .attacking {
        overlay: rect(#66FF8800);
        }

        .attacked {
        overlay: rect(#66FF0000);
        }

        /* ── Chain link number, drawn on the slot the effect triggered from ── */
        .chain-marker {
        position: absolute;
        bottom: 0;
        left: 0;
        font-size: 5;
        background: rect(#CC7722AA);
        text-color: #FFFFFF;
        padding-horizontal: 1;
        }

        .chain-marker.chain-solving {
        background: rect(#CCFFAA00);
        text-color: #000000;
        }

        .chain-marker.negated {
        background: rect(#CCCC0000);
        text-color: #FFDDDD;
        }

        /* ── Card Action Context Menu ── */
        #context-menu {
        position: absolute;
        flex-direction: row;
        gap-all: 1;
        padding-all: 1;
        background: rect(#1A1A2E, 2, 1, #4444AA);
        z-index: 10;
        }

        #context-menu.hidden {
        display: none;
        }

        .ctx-action {
        width: 14;
        height: 14;
        align-items: center;
        justify-content: center;
        }

        /* ── Rule-driven visibility (FieldRenderer assigns these classes) ── */
        .rule-hidden {
        display: none;
        }

        .pendulum-marker {
        display: none;
        }

        .pendulum > .pendulum-marker {
        display: flex;
        }

        .zone-icon.pendulum-marker.hidden {
        display: none;
        }
    </style>

    <root id="duel-root">
        <element id="duel-canvas">

        <!-- HUD Bar (top overlay: LP bars + duel title) -->
        <element id="hud-bar">
            <progress-bar id="plr-lp-bar" class="lp-bar" min-value="0" max-value="8000" value="8000" text="8000" />
            <element id="hud-info">
                <label id="hud-turn-phase">Turn 1 - Main Phase 1</label>
                <label id="duel-title-label">Joey vs. Weevil</label>
            </element>
            <button id="log-toggle" text="Log" />
            <button id="concede-btn" text="Concede" />
            <progress-bar id="opp-lp-bar" class="lp-bar" min-value="0" max-value="8000" value="8000" text="8000" />
        </element>

        <!-- ══════════ Field Area ══════════ -->
        <element id="field-area" class="panel_bg">
            <!-- Background layers -->
            <element id="field-bg-opp" class="field-bg-half" />
            <element id="field-bg-plr" class="field-bg-half" />

            <scroller-view id="opponent-hand" class="hand-row">
            </scroller-view>

            <!-- ── Opponent Side ── -->
            <element id="opponent-side" class="player-side">
                <!-- Opponent Left Piles: Extra Deck, Pendulum (left, MR3 only), Field Spell -->
                <element id="opp-piles-left" class="pile-column">
                    <element id="opp-extra-deck" class="card-slot pile-slot">
                        <element class="zone-icon"
                                 style="background: sprite(minecraft:textures/block/spawner.png);" />
                        <label class="card-count">0</label>
                    </element>
                    <element id="opp-pz-left" class="card-slot zone-slot pz-slot">
                        <element class="zone-icon"
                                 style="background: sprite(minecraft:textures/item/lapis_lazuli.png)" />
                    </element>
                    <element id="opp-field-spell" class="card-slot pile-slot">
                        <element class="zone-icon"
                                 style="background: sprite(minecraft:textures/item/seagrass.png);" />
                    </element>
                </element>

                <!-- Opponent Zone Rows -->
                <element id="opp-zones" class="zone-grid">
                    <!-- Opponent S/T Row (far side) -->
                    <element id="opp-st-row" class="zone-row">
                        <element id="opp-st-0" class="square-slot zone-slot">
                            <element class="zone-icon pendulum-marker"
                                     style="background: sprite(minecraft:textures/item/lapis_lazuli.png)" />
                        </element>
                        <element id="opp-st-1" class="square-slot zone-slot">
                            <element class="zone-icon pendulum-marker"
                                     style="background: sprite(minecraft:textures/item/lapis_lazuli.png)" />
                        </element>
                        <element id="opp-st-2" class="square-slot zone-slot" />
                        <element id="opp-st-3" class="square-slot zone-slot">
                            <element class="zone-icon pendulum-marker"
                                     style="background: sprite(minecraft:textures/item/redstone.png)" />
                        </element>
                        <element id="opp-st-4" class="square-slot zone-slot">
                            <element class="zone-icon pendulum-marker"
                                     style="background: sprite(minecraft:textures/item/redstone.png)" />
                        </element>
                    </element>
                    <!-- Opponent Monster Row -->
                    <element id="opp-mon-row" class="zone-row">
                        <element id="opp-mon-0" class="square-slot zone-slot" />
                        <element id="opp-mon-1" class="square-slot zone-slot" />
                        <element id="opp-mon-2" class="square-slot zone-slot" />
                        <element id="opp-mon-3" class="square-slot zone-slot" />
                        <element id="opp-mon-4" class="square-slot zone-slot" />
                    </element>
                </element>

                <!-- Opponent Right Piles: Deck, Pendulum (right, MR3 only), Graveyard -->
                <element id="opp-piles-right" class="pile-column">
                    <element id="opp-deck" class="card-slot pile-slot">
                        <element class="zone-icon"
                                 style="background: sprite(minecraft:textures/item/book.png);" />
                        <label class="card-count">40</label>
                    </element>
                    <element id="opp-pz-right" class="card-slot zone-slot pz-slot">
                        <element class="zone-icon"
                                 style="background: sprite(minecraft:textures/item/redstone.png)" />
                    </element>
                    <element id="opp-graveyard" class="card-slot pile-slot">
                        <element class="zone-icon"
                                 style="background: sprite(minecraft:textures/item/bone.png);" />
                        <label class="card-count">0</label>
                    </element>
                </element>
            </element>

            <!-- ── Center Row: Extra Monster Zones + Controls ── -->
            <element id="center-row">
                <element id="opp-piles-banished" class="pile-column">
                    <element id="opp-banished" class="card-slot pile-slot">
                        <label class="card-count">0</label>
                    </element>
                </element>
                <element id="center-controls">
                    <button id="phase-btn-left" class="phase-btn" text="SP" />
                    <element id="emz-left" class="square-slot emz-slot" />
                    <button id="phase-btn-center" class="phase-btn" text="BP" />
                    <element id="emz-right" class="square-slot emz-slot" />
                    <button id="phase-btn-right" class="phase-btn" text="EP" />
                    <button id="shuffle-btn" class="hidden" text="Shuffle" />
                </element>
                <element id="plr-piles-banished" class="pile-column">
                    <element id="plr-banished" class="card-slot pile-slot">
                        <label class="card-count">0</label>
                    </element>
                </element>
            </element>

            <!-- ── Player Side ── -->
            <element id="player-side" class="player-side">
                <!-- Player Left Piles: Field Spell, Pendulum (left, MR3 only), Extra Deck -->
                <element id="plr-piles-left" class="pile-column">
                    <element id="plr-field-spell" class="card-slot pile-slot">
                        <element class="zone-icon"
                                 style="background: sprite(minecraft:textures/item/seagrass.png)" />
                    </element>
                    <element id="plr-pz-left" class="card-slot zone-slot pz-slot">
                        <element class="zone-icon"
                                 style="background: sprite(minecraft:textures/item/lapis_lazuli.png)" />
                    </element>
                    <element id="plr-extra-deck" class="card-slot pile-slot">
                        <element class="zone-icon"
                                 style="background: sprite(minecraft:textures/block/spawner.png)" />
                        <label class="card-count">0</label>
                    </element>
                </element>

                <!-- Player Zone Rows -->
                <element id="plr-zones" class="zone-grid">
                    <!-- Player Monster Row -->
                    <element id="plr-mon-row" class="zone-row">
                        <element id="plr-mon-0" class="square-slot zone-slot" />
                        <element id="plr-mon-1" class="square-slot zone-slot" />
                        <element id="plr-mon-2" class="square-slot zone-slot" />
                        <element id="plr-mon-3" class="square-slot zone-slot" />
                        <element id="plr-mon-4" class="square-slot zone-slot" />
                    </element>
                    <!-- Player S/T Row -->
                    <element id="plr-st-row" class="zone-row">
                        <element id="plr-st-0" class="square-slot zone-slot">
                            <element class="zone-icon pendulum-marker"
                                     style="background: sprite(minecraft:textures/item/lapis_lazuli.png)" />
                        </element>
                        <element id="plr-st-1" class="square-slot zone-slot">
                            <element class="zone-icon pendulum-marker"
                                     style="background: sprite(minecraft:textures/item/lapis_lazuli.png)" />
                        </element>
                        <element id="plr-st-2" class="square-slot zone-slot" />
                        <element id="plr-st-3" class="square-slot zone-slot">
                            <element class="zone-icon pendulum-marker"
                                     style="background: sprite(minecraft:textures/item/redstone.png)" />
                        </element>
                        <element id="plr-st-4" class="square-slot zone-slot">
                            <element class="zone-icon pendulum-marker"
                                     style="background: sprite(minecraft:textures/item/redstone.png)" />
                        </element>
                    </element>
                </element>

                <!-- Player Right Piles: Graveyard, Pendulum (right, MR3 only), Deck -->
                <element id="plr-piles-right" class="pile-column">
                    <element id="plr-graveyard" class="card-slot pile-slot">
                        <element class="zone-icon"
                                 style="background: sprite(minecraft:textures/item/bone.png);" />
                        <label class="card-count">0</label>
                    </element>
                    <element id="plr-pz-right" class="card-slot zone-slot pz-slot">
                        <element class="zone-icon"
                                 style="background: sprite(minecraft:textures/item/redstone.png)" />
                    </element>
                    <element id="plr-deck" class="card-slot pile-slot">
                        <element class="zone-icon"
                                 style="background: sprite(minecraft:textures/item/book.png);" />
                        <label class="card-count">40</label>
                    </element>
                </element>
            </element>

            <!-- ── Player Hand ── -->
            <scroller-view id="player-hand" class="hand-row">
                <!-- Hand cards are added dynamically in Java -->
            </scroller-view>
        </element>

        <!-- ══════════ OVERLAYS (absolute positioned) ══════════ -->

        <!-- Status Label (chain / waiting overlay) -->
        <label id="status-label" class="hidden">Waiting...</label>

        <!-- Chain depth, kept off the status label so prompt captions are not overwritten -->
        <label id="chain-count" class="hidden">Chain: 1</label>

        <!-- Hint toast (one declaration hint at a time, a couple of seconds each) -->
        <label id="toast" class="hidden">Opponent declared: []</label>

        <!-- Turn and phase banner (MSG_NEW_TURN / MSG_NEW_PHASE) -->
        <label id="banner" class="hidden">Battle Phase</label>

        <!-- Floating LP numbers, one per absolute player index -->
        <label id="lp-delta-0" class="lp-delta hidden">-500</label>
        <label id="lp-delta-1" class="lp-delta hidden">-500</label>

        <!-- Refcounted player hints (MSG_PLAYER_HINT), under each player's name -->
        <label id="plr-hints" class="player-hints" />
        <label id="opp-hints" class="player-hints" />

        <!-- Shared Cancel/Finish button for field selections, also bound to right-click -->
        <element id="prompt-action-bar">
            <button id="prompt-action-btn" class="prompt-btn hidden" text="Finish" />
        </element>

        <!-- Card Info Banner (left, shown on hover) -->
        <element id="card-info-banner" class="hidden">
            <element id="card-image-area" />
            <text id="card-name-label" class="card-label">Number 11: Big Eye</text>
            <text id="card-stats-label" class="card-label">DARK / Rank 7 / Spellcaster / Xyz /
                Effect</text>
            <scroller-view id="card-text-scroll">
                <text id="card-text">Pendulum Effect: You can remove 6 Spell Counters from your
                    field; Special Summon this card from the Pendulum Zone, then count the number of
                    cards you control that can have a Spell Counter, destroy up to that many cards
                    on the field, and if you do, place Spell Counters on this card equal to the
                    number of cards destroyed. You can only use this effect of "Endymion, the Mighty
                    Master of Magic" once per turn. Monster Effect: Once per turn, when a Spell/Trap
                    Card or effect is activated (Quick Effect): You can return 1 card you control
                    with a Spell Counter to the hand, and if you do, negate the activation, and if
                    you do that, destroy it. Then, you can place the same number of Spell Counters
                    on this card that the returned card had. While this card has a Spell Counter,
                    your opponent cannot target it with card effects, also it cannot be destroyed by
                    your opponent's card effects. When this card with a Spell Counter is destroyed
                    by battle: You can add 1 Normal Spell from your Deck to your hand. </text>
            </scroller-view>
            <text id="card-atk-def-label" class="card-label">ATK 2600 / DEF 2000</text>
            <text id="card-hints" class="card-label hidden" />
        </element>

        <!-- Duel log (left, toggled from the HUD; declared after the card info banner so it wins) -->
        <element id="duel-log" class="hidden">
            <label id="duel-log-title">Duel log</label>
            <scroller-view id="duel-log-list">
                <!-- Log lines added dynamically in Java -->
            </scroller-view>
            <button id="duel-log-close" text="Close" />
        </element>

        <!-- Zone Inspector (right, toggled by clicking a pile) -->
        <element id="zone-inspector" class="hidden">
            <label id="zone-inspector-title">Graveyard (#)</label>
            <scroller-view id="zone-inspector-list">
                <!-- Inspector entries added dynamically in Java -->
            </scroller-view>
            <button id="zone-inspector-close" text="Close" />
        </element>

        <!-- Prompt Dialog (centered overlay for selections) -->
        <element id="prompt-overlay" class="hidden">
            <element id="prompt-dialog">
                <label id="prompt-title">Select an option</label>
                <element id="prompt-body">
                    <!-- Prompt-specific content added dynamically -->
                </element>
                <element id="prompt-buttons">
                    <!-- Confirm/Cancel buttons added dynamically -->
                </element>
            </element>
        </element>

        <!-- Duel Result Overlay (winner and reason, shown when the duel ends) -->
        <element id="result-overlay" class="hidden">
            <element id="result-dialog">
                <label id="result-title">Duel over</label>
                <label id="result-reason">Life points</label>
                <button id="result-close" class="prompt-btn" text="Close" />
            </element>
        </element>

        <!-- Hint Modal (HINT_MESSAGE: a message that blocks until acknowledged) -->
        <element id="hint-modal" class="hidden">
            <element id="hint-modal-dialog">
                <label id="hint-modal-text">Message</label>
                <button id="hint-modal-ok" class="prompt-btn" text="OK" />
            </element>
        </element>

        <!-- Pause Overlay (ESC while the duel is live) -->
        <element id="pause-overlay" class="hidden">
            <element id="pause-dialog">
                <label id="pause-title">Leave duel?</label>
                <element id="pause-buttons">
                    <button id="pause-concede" class="prompt-btn" text="Concede" />
                    <button id="pause-stay" class="prompt-btn" text="Stay" />
                </element>
            </element>
        </element>

        <!-- Card Action Context Menu (positioned at cursor on card click) -->
        <element id="context-menu" class="hidden" />

        </element>
    </root>
</ldlib2-ui>